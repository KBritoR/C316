# Copie este arquivo para .env e ajuste os valores se precisar:
#   cp .env.example .env
# O .env nao vai para o repositorio. Sem ele, o docker-compose.yml usa
# os mesmos valores padrao abaixo (apenas para desenvolvimento local).

# Banco de dados (PostgreSQL)
POSTGRES_USER=estoque
POSTGRES_PASSWORD=estoque
POSTGRES_DB=estoque

# Portas publicadas no computador
DB_PORT=5432
API_PORT=8000
