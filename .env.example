# Copie este arquivo para .env e ajuste os valores se precisar:
#   cp .env.example .env
# O .env nao vai para o repositorio. Sem ele, o docker-compose.yml usa
# os mesmos valores padrao abaixo (apenas para desenvolvimento local).

# Banco de dados (PostgreSQL)
POSTGRES_USER=estoque
POSTGRES_PASSWORD=estoque
POSTGRES_DB=estoque

# Portas publicadas no computador
DB_PORT=5432
API_PORT=8000
FRONTEND_PORT=5173

# CORS_ORIGINS: origens do frontend que podem chamar a API, separadas por virgula.
# VITE_API_URL: endereco da API usado pelo navegador.
# Por padrao o docker-compose.yml monta os dois a partir de FRONTEND_PORT e API_PORT,
# entao so descomente se precisar de um valor diferente.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# VITE_API_URL=http://localhost:8000

# Usadas quando a API ou os testes rodam FORA do Docker (make run / make test).
# Dentro do Compose, o docker-compose.yml monta a DATABASE_URL com o host "db".
# Os valores abaixo ja sao o padrao do codigo; so defina se mudar usuario/senha/porta.
# DATABASE_URL=postgresql+psycopg://estoque:estoque@localhost:5432/estoque
# TEST_DATABASE_URL=postgresql+psycopg://estoque:estoque@localhost:5432/estoque_test
