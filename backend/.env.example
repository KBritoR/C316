# URL de conexao com o PostgreSQL (SQLAlchemy + driver psycopg3).
# Ao rodar via Docker Compose, o docker-compose.yml ja injeta a variante com o
# host `db` automaticamente; este valor serve para rodar o backend fora do Docker
# (com `docker compose up -d db` subindo so o banco, publicado em localhost:5432).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/appdb
